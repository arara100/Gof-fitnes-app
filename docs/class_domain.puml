@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50
title Доменна модель
  class User {
    id
    email
    password_hash
    role
  }
  class Profile {
    gender
    age
    weight_kg
    height_cm
    goal
  }
  abstract class Workout {
    id
    title
    duration_min
    difficulty
    {abstract} type()
  }
  class CardioWorkout
  class StrengthWorkout
  class YogaWorkout
  class WorkoutPlan {
    id
    name
    goal
  }
  class PlanItem {
    day_of_week
    position
  }
  class WorkoutSession {
    performed_at
    duration_min
    calories
  }
  class WeightEntry {
    date
    weight_kg
  }
  class Reminder {
    time
    days
    enabled
  }
  class Achievement {
    code
    title
    condition
  }
  class Challenge {
    title
    start_date
    end_date
    target
  }
  class ChallengeParticipation {
    progress
  }

  Workout <|-- CardioWorkout
  Workout <|-- StrengthWorkout
  Workout <|-- YogaWorkout
  User "1" -- "1" Profile
  User "1" -- "*" WorkoutPlan
  WorkoutPlan "1" *-- "*" PlanItem
  PlanItem "*" --> "1" Workout
  User "1" -- "*" WorkoutSession
  WorkoutSession "*" --> "1" Workout
  User "1" -- "*" WeightEntry
  User "1" -- "*" Reminder
  User "*" -- "*" Achievement
  User "1" -- "*" ChallengeParticipation
  Challenge "1" -- "*" ChallengeParticipation
@enduml
